<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FF0B0F17"
    android:padding="8dp">

    <!-- ===== LEFT COLUMN ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--°"
            android:textColor="#FFFFC857"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFAAAAAA"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_dates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#FFCCCCCC"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_solar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="#FFFFC857"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#FF2A3548" />

    <!-- ===== RIGHT COLUMN ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_hourly_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ساعتی"
            android:textColor="#FF8B9AAB"
            android:textSize="10sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_hourly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="#FFEEEEEE"
            android:textSize="12sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_daily_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="روزانه"
            android:textColor="#FF8B9AAB"
            android:textSize="10sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_daily"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="#FFEEEEEE"
            android:textSize="12sp"
            android:includeFontPadding="false" />

    </LinearLayout>

</LinearLayout>
