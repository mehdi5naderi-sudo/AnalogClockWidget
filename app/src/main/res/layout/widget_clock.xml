<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B0F17"
    android:padding="10dp">

    <!-- ==================== LEFT: Clock + Date + Solar ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Big Clock -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14:32"
            android:textColor="#F3F5F7"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <!-- Weekday -->
        <TextView
            android:id="@+id/tv_weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="شنبه"
            android:textColor="#F3F5F7"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <!-- Dates (Jalali + Gregorian) -->
        <TextView
            android:id="@+id/tv_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="۲۳ آبان  ·  ۱۴ نوامبر"
            android:textColor="#8B9AAB"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <!-- Sunrise / Sunset -->
        <TextView
            android:id="@+id/tv_solar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="۰۶:۴۰  ·  ۱۷:۰۰"
            android:textColor="#FFC857"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:background="#2A3548" />

    <!-- ==================== CENTER: Current Weather ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۱۶°"
            android:textColor="#FFC857"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="صاف  ·  ۱۳°"
            android:textColor="#8B9AAB"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="آخرین به‌روزرسانی: --:--"
            android:textColor="#5A6A7A"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:background="#2A3548" />

    <!-- ==================== RIGHT: Forecast ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Hourly title -->
        <TextView
            android:id="@+id/tv_hourly_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ساعتی"
            android:textColor="#8B9AAB"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_hourly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="۱۴°  ۱۵°  ۱۶°  ۱۷°  ۱۸°  ۱۹°"
            android:textColor="#F3F5F7"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:lineSpacingExtra="2dp" />

        <!-- Daily title -->
        <TextView
            android:id="@+id/tv_daily_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="روزانه"
            android:textColor="#8B9AAB"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ش ۱۷/۶  ی ۱۷/۵  د ۱۶/۵"
            android:textColor="#F3F5F7"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</LinearLayout>
