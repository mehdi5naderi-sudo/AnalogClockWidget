<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FF0B0F17"
    android:padding="8dp">

    <!-- LEFT: Clock + Date + Solar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14:32"
            android:textColor="#FFF3F5F7"
            android:textSize="40sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="شنبه"
            android:textColor="#FFF3F5F7"
            android:textSize="14sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="۲۳ آبان · ۱۴ نوامبر"
            android:textColor="#FF8B9AAB"
            android:textSize="12sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_solar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="۰۶:۴۰ · ۱۷:۰۰"
            android:textColor="#FFFFC857"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#FF2A3548" />

    <!-- CENTER: Current Weather -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۱۶°"
            android:textColor="#FFFFC857"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="صاف · ۱۳°"
            android:textColor="#FF8B9AAB"
            android:textSize="12sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#FF5A6A7A"
            android:textSize="10sp"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#FF2A3548" />

    <!-- RIGHT: Forecast -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_hourly_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ساعتی"
            android:textColor="#FF8B9AAB"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_hourly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="۱۴° ۱۵° ۱۶° ۱۷° ۱۸° ۱۹°"
            android:textColor="#FFF3F5F7"
            android:textSize="11sp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tv_daily_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="روزانه"
            android:textColor="#FF8B9AAB"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ش ۱۷/۶  ی ۱۷/۵  د ۱۶/۵"
            android:textColor="#FFF3F5F7"
            android:textSize="11sp"
            android:maxLines="2" />

    </LinearLayout>

</LinearLayout>
